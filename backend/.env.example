# Postgres (host port 5434 -- see docker-compose.yml: 5432/5433 are already
# taken by UC1's and UC2's postgres containers when the projects run side by
# side on this machine)
DATABASE_URL=postgresql+psycopg://breach_analytics:breach_analytics_dev@localhost:5434/breach_analytics

# API auth
API_KEY=changeme-dev-key

# CORS (comma-separated origins). Vite dev server (5175) plus the production
# preview build (4173, `npm run preview`) -- UC2's verification checklist
# checked the console against the PRODUCTION build, which a dev-server-only
# origin silently broke there.
CORS_ORIGINS=http://localhost:5175,http://localhost:4173

# DeepSeek (tier 1 -- cheap text-only extraction; docs/plan.md D3)
# Hosted via Azure AI Foundry's Model Inference API -- DEEPSEEK_MODEL is the
# Foundry DEPLOYMENT NAME, not DeepSeek's own model id.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ai-training-msftfoundry.services.ai.azure.com/models
DEEPSEEK_API_VERSION=2024-05-01-preview
DEEPSEEK_MODEL=DeepSeek-V3.2

# Anthropic (tier 2 escalation + the four agents; docs/plan.md D3)
# AGENT_MODEL is a knob so the cost/accuracy comparison can downgrade agents
# without a code change.
ANTHROPIC_API_KEY=
TIER2_MODEL=claude-sonnet-4-6
AGENT_MODEL=claude-opus-5

# Tier escalation threshold theta (docs/plan.md §9: Config A economy=0.6,
# Config B assurance=0.8)
TIER2_ESCALATION_THRESHOLD=0.8

# ER band thresholds (docs/plan.md D5) -- calibrated against the manifest Wed
ER_AUTO_LINK_THRESHOLD=0.85
ER_DISTINCT_THRESHOLD=0.45

# Agent budget defaults (docs/plan.md §3's table)
ORCHESTRATOR_MAX_STEPS=15
ORCHESTRATOR_MAX_USD=1.00
INVESTIGATOR_MAX_STEPS=12
INVESTIGATOR_MAX_TOKENS=60000
INVESTIGATOR_MAX_USD=0.50
ADJUDICATOR_MAX_STEPS=10
ADJUDICATOR_MAX_USD=0.30
AUDITOR_MAX_STEPS_PER_FLAG=3
AUDITOR_MAX_USD_PER_RUN=2.00

# Storage (content-addressed originals + rasterized page-image cache)
STORAGE_ROOT=./storage

# Parsing / routing thresholds (docs/plan.md §3: OCR when <120 chars/page or
# garbage ratio >0.3) -- provisional until measured against the corpus
OCR_MIN_CHARS_PER_PAGE=120
OCR_MIN_CHAR_DENSITY_RATIO=0.08
OCR_MAX_GARBAGE_RATIO=0.30
RENDER_DPI=300

# Review-queue thresholds -- TODO-calibrate Wed against the manifest
REVIEW_FLAG_CONFIDENCE_THRESHOLD=0.80
REVIEW_ER_CONFIDENCE_THRESHOLD=0.85

# Background job concurrency (docs/plan.md §14: full-corpus run at 3-5)
EXTRACTION_MAX_CONCURRENCY=3

# Logging
LOG_LEVEL=INFO
